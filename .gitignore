# --- Editors / OS ---
.idea
.DS_Store
.DS_STORE

# --- Dependencies / build output ---
node_modules
dist

# --- Tool work dirs: contents are user data, never tracked ---
# Every tool uses in/ (drop files here), out/ (results), archive/ (archived runs),
# and temp/ (scratch). Only the .gitkeep placeholders are tracked.
**/in/*
!**/in/.gitkeep
**/out/*
!**/out/.gitkeep
**/archive/
**/temp/

# Legacy dir names (pre-standardization archives that may still exist on disk)
**/img-in/
**/img-out/
**/img-archive/

# --- Large / generated file types ---
**/*.pdf
**/*.rar
**/*.stl
**/*.chitubox
**/*.lys
**/u2net.onnx

# --- ocr-pdf: generated markdown ---
ocr-pdf/md/*
!ocr-pdf/md/.gitkeep

# --- keep-mac-awake: compiled per-machine on first run ---
keep-mac-awake/bin/

# --- Downloaded binaries (ffmpeg, yt-dlp) - never tracked ---
# Shared across all tools; populated by `npm run setup:ffmpeg`
tools/
get-audio/tools/
